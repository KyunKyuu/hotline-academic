<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all requests to the public/ folder if they don't already start with /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive development and configuration files
<FilesMatch "^\.env|composer\.json|composer\.lock|package\.json|package-lock\.json|vite\.config\.js|artisan|phpunit\.xml$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory browsing for security
Options -Indexes
